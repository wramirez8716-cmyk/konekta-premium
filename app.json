{
  "expo": {
    "name": "Konekta Premium",
    "slug": "konekta-premium",
    "owner": "werms-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Permitir que Konekta Premium acceda a tus contactos para encontrar amigos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ]
    ],
    "android": {
      "package": "com.konekta.premium",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "6d33db60-b299-41a1-921d-43b0d5ad999b"
      }
    }
  }
}
